# Copy to .env and adjust. Only ~20 variables: everything optional beyond these.
JETSTREAM_PROJECT={{MACHINE}}
JETSTREAM_HOST_PORT=8080
WEBROOT=/app/web

DRUPAL_DB_HOST=db
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal
DRUPAL_DB_PASSWORD=drupal
DRUPAL_DB_PORT=3306

DRUPAL_HASH_SALT=change-me-in-env
DRUPAL_CONFIG_PATH=../config/default
DRUPAL_ENV=local

# Redis object cache (needs: docker compose --profile redis up -d).
# DRUPAL_REDIS_HOST=redis

# Lagoon hosting (only when installed with hosting=lagoon).
# LAGOON_PROJECT={{MACHINE}}
# LAGOON_ENVIRONMENT=main
