{
    "name": "{{ORG}}/{{MACHINE}}",
    "description": "{{DESCRIPTION}}",
    "type": "project",
    "license": "proprietary",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "drupal/admin_toolbar": "^3.4",
        "drupal/config_split": "^2.0",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-recommended": "^11",
        "drupal/pathauto": "^1.13",
        "drupal/redirect": "^1.13",
        "drush/drush": "^13"
    },
    "require-dev": {
        "drupal/devel": "^5.5",
        "drupal/stage_file_proxy": "^4"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        }
    },
    "scripts": {
        "up": "docker compose up -d",
        "down": "docker compose down",
        "build": [
            "@composer install",
            "docker compose exec web composer install --working-dir=/app",
            "docker compose exec web drush --root=/app/web site:install minimal --existing-config --account-mail={{ADMIN_EMAIL}} -y"
        ],
        "provision": [
            "docker compose exec web drush --root=/app/web sql:query --file=/app/.data/db.sql",
            "docker compose exec web drush --root=/app/web updatedb -y",
            "docker compose exec web drush --root=/app/web config:import -y",
            "docker compose exec web drush --root=/app/web cache:rebuild"
        ],
        "test": "docker compose exec web drush --root=/app/web status --field=drupal-version",
        "login": "docker compose exec web drush --root=/app/web user:login"
    }
}
